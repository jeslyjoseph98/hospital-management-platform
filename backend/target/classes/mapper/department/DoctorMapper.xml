<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hms.department.mapper.DoctorMapper">

  <resultMap id="doctorResultMap" type="com.hms.department.model.Doctor">
    <id property="id" column="id"/>
    <result property="userId" column="user_id"/>
    <result property="departmentId" column="department_id"/>
    <result property="fullName" column="full_name"/>
    <result property="qualification" column="qualification"/>
    <result property="specialization" column="specialization"/>
    <result property="registrationNumber" column="registration_number"/>
    <result property="experienceYears" column="experience_years"/>
    <result property="phone" column="phone"/>
    <result property="email" column="email"/>
    <result property="about" column="about"/>
    <result property="consultationFee" column="consultation_fee"/>
    <result property="dailyLimit" column="daily_limit"/>
    <result property="active" column="is_active"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
    <result property="createdBy" column="created_by"/>
    <result property="updatedBy" column="updated_by"/>
  </resultMap>

  <resultMap id="availabilityResultMap" type="com.hms.department.model.DoctorAvailability">
    <id property="id" column="id"/>
    <result property="doctorId" column="doctor_id"/>
    <result property="dayOfWeek" column="day_of_week"/>
    <result property="startTime" column="start_time"/>
    <result property="endTime" column="end_time"/>
    <result property="active" column="is_active"/>
  </resultMap>

  <sql id="doctorColumns">
    id, user_id, department_id, full_name, qualification, specialization, registration_number,
    experience_years, phone, email, about, consultation_fee, daily_limit, is_active,
    created_at, updated_at, created_by, updated_by
  </sql>

  <select id="findActiveByDepartment" resultMap="doctorResultMap">
    SELECT <include refid="doctorColumns"/>
    FROM doctors WHERE department_id = #{departmentId} AND is_active = 1 ORDER BY full_name
  </select>

  <select id="findActiveById" resultMap="doctorResultMap">
    SELECT <include refid="doctorColumns"/>
    FROM doctors WHERE id = #{id} AND is_active = 1
  </select>

  <select id="lockForBooking" resultMap="doctorResultMap">
    SELECT <include refid="doctorColumns"/>
    FROM doctors WHERE id = #{id} FOR UPDATE
  </select>

  <select id="findActiveAvailability" resultMap="availabilityResultMap">
    SELECT id, doctor_id, day_of_week, start_time, end_time, is_active
    FROM doctor_availability WHERE doctor_id = #{doctorId} AND is_active = 1 ORDER BY day_of_week
  </select>

  <select id="findActiveAvailabilityForDay" resultMap="availabilityResultMap">
    SELECT id, doctor_id, day_of_week, start_time, end_time, is_active
    FROM doctor_availability WHERE doctor_id = #{doctorId} AND day_of_week = #{dayOfWeek} AND is_active = 1
  </select>

  <!-- spec 03 APT-R7 / spec 06 §4: COMPLETED appointments still occupy their slot. -->
  <select id="countBookedAppointments" resultType="int">
    SELECT COUNT(*) FROM appointments
    WHERE doctor_id = #{doctorId} AND appointment_date = #{date} AND status &lt;&gt; 'CANCELLED'
  </select>

  <select id="findActiveByRegistrationNumber" resultMap="doctorResultMap">
    SELECT <include refid="doctorColumns"/>
    FROM doctors WHERE registration_number = #{registrationNumber} AND is_active = 1
  </select>

  <select id="findByUserId" resultMap="doctorResultMap">
    SELECT <include refid="doctorColumns"/>
    FROM doctors WHERE user_id = #{userId}
  </select>

  <update id="linkUser">
    UPDATE doctors SET user_id = #{userId} WHERE id = #{id}
  </update>

</mapper>
