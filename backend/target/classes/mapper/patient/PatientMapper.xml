<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hms.patient.mapper.PatientMapper">

  <resultMap id="patientResultMap" type="com.hms.patient.model.Patient">
    <id property="id" column="id"/>
    <result property="userId" column="user_id"/>
    <result property="patientCode" column="patient_code"/>
    <result property="dateOfBirth" column="date_of_birth"/>
    <result property="gender" column="gender"/>
    <result property="address" column="address"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>

  <sql id="columns">
    id, user_id, patient_code, date_of_birth, gender, address, created_at, updated_at
  </sql>

  <select id="findByUserId" resultMap="patientResultMap">
    SELECT <include refid="columns"/> FROM patients WHERE user_id = #{userId}
  </select>

  <select id="findById" resultMap="patientResultMap">
    SELECT <include refid="columns"/> FROM patients WHERE id = #{id}
  </select>

  <insert id="insert" parameterType="com.hms.patient.model.Patient" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO patients (user_id, date_of_birth, gender, address)
    VALUES (#{userId}, #{dateOfBirth}, #{gender}, #{address})
  </insert>

  <update id="updatePatientCode">
    UPDATE patients SET patient_code = #{patientCode} WHERE id = #{id}
  </update>

</mapper>
